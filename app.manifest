<?xml version="1.0" encoding="utf-8"?>
<assembly manifestVersion="1.0" xmlns="urn:schemas-microsoft-com:asm.v1">
  <assemblyIdentity version="1.0.0.0" name="GameTrainer.app"/>
  <trustInfo xmlns="urn:schemas-microsoft-com:asm.v2">
    <security>
      <requestedPrivileges xmlns="urn:schemas-microsoft-com:asm.v3">
        <!--
          On utilise "asInvoker" ici car les droits admin sont gérés
          par la tâche planifiée (install.ps1), ce qui évite le popup UAC.
          Si tu lances l'exe directement (sans la tâche), il n'aura PAS
          les droits admin → utilise toujours le raccourci du bureau.
        -->
        <requestedExecutionLevel level="asInvoker" uiAccess="false" />
      </requestedPrivileges>
    </security>
  </trustInfo>
</assembly>
